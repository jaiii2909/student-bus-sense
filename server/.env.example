MONGO_URI=your-mongo-uri
PORT=5001
# Long random string used to sign login tokens (keeps users logged in across restarts)
JWT_SECRET=change-me
# Driver password: a bcrypt hash (recommended) or plain text
DRIVER_PASSWORD_HASH=
# DRIVER_PASSWORD=driver123
# Frontend URL(s) allowed to call the API, comma separated (unset = allow all)
CORS_ORIGINS=https://your-app.vercel.app
# Failed logins allowed per IP per 15 minutes (default 20)
# LOGIN_MAX_FAILED_ATTEMPTS=20
